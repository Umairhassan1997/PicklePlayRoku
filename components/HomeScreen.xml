<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/HomeScreen.brs" />
	<script type="text/brightscript" uri="pkg:/components/VerifySubscription.brs" />
	<script type="text/brightscript" uri="pkg:/components/Managers/SubscriptionManager.brs" />
	<script type="text/brightscript" uri="pkg:/components/NavBar.brs" />
  
  <interface>
    <field id="isSubscribed" type="boolean" alwaysNotify="true" />
    <field id="btnHomeSelected" alias="btnHome.buttonSelected" />


  </interface>
  <children>
      
    <Rectangle translation="[0,0]" width="1920" height="1080" color="0x121213" />
