<?xml version="1.0" encoding="utf-8" ?>
<component name="LivePlayerScreen" extends="Group">
  <script type="text/brightscript" uri="pkg:/components/LivePlayerScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/Managers/ChannelManager.brs" />
  <script type="text/brightscript" uri="pkg:/components/Managers/UsageTimerManager.brs" />
  <script type="text/brightscript" uri="pkg:/components/Managers/SubscriptionManager.brs" />

  <interface>
    <field id="timeExpired" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="0x000000" />

    <!-- UI overlays must be children of Video or they draw underneath playback -->
    <Video
      id="liveVideo"
      width="1920"
      height="1080"
      translation="[0,0]"
      enableUI="false"
      enableTrickPlay="false">

      <BusySpinner id="bufferingSpinner" translation="[900,490]" visible="false" />

      <Group id="channelOverlay" translation="[60,60]" visible="false">
        <Rectangle width="520" height="160" color="0x000000" opacity="0.75" />
        <Label
          id="channelNumberLabel"
          translation="[24,20]"
          width="472"
          height="48"
          color="0xCCCCCC"
          horizAlign="left"
          vertAlign="center">
          <Font role="font" uri="pkg:/components/Fonts/Roboto-Regular.ttf" size="32" />
        </Label>
        <Label
          id="channelNameLabel"
          translation="[24,72]"
          width="472"
          height="72"
          color="0xFFFFFF"
          wrap="true"
          maxLines="2"
          horizAlign="left"
          vertAlign="top">
          <Font role="font" uri="pkg:/components/Fonts/Roboto-Regular.ttf" size="40" />
        </Label>
      </Group>

      <Label
        id="errorLabel"
        translation="[260,480]"
        width="1400"
        height="120"
        visible="false"
        color="0xFFFFFF"
        wrap="true"
        maxLines="3"
        horizAlign="center"
        vertAlign="center"
        text="Unable to play channel.&#xA;Press Left or Right to try another channel.">
        <Font role="font" uri="pkg:/components/Fonts/Roboto-Regular.ttf" size="36" />
      </Label>
    </Video>

    <Timer id="overlayHideTimer" duration="2.5" repeat="false" />
    <Timer id="usageTickTimer" duration="1" repeat="true" />
  </children>
</component>
