<component name="HeroItem" extends="Group">
    <script type="text/brightscript" uri="HeroItem.brs" />
      <interface>
    <field id="itemContent" type="node" onChange="itemContentChanged"/>
    <field id="focusPercent" type="float" onChange="showfocus" />
        <field id="rowHasFocus" type="boolean" onChange="showrowfocus" />
         <field id="gridHasFocus" type="boolean" onChange="showrowfocus"  />
         <field id="itemHasFocus" type="boolean"    />





  </interface>
  <children>


    <Poster translation="[0,0]" width="503" height="366" uri="pkg:/images/temUF.png" />
  
    <Poster  id="itemImage" translation="[0,0]" width="503" height="366"   />

       

       

        <Label
	        id="itemName"
			translation="[0,230]"
             
            color="#FFFFFF"
            lineSpacing= "0" 
            width="503"
            height="40"
            vertAlign="center"
            horizAlign="center"
            >

            <Font role="font" uri="pkg:/components/Fonts/Roboto-Regular.ttf" size="28" />
            
        </Label>



  </children>
    
</component>