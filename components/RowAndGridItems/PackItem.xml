<component name="PackItem" extends="Group">
    <script type="text/brightscript" uri="PackItem.brs" />
      <interface>
    <field id="itemContent" type="node" onChange="itemContentChanged"/>
    <field id="focusPercent" type="float" onChange="showfocus" />
        <field id="gridHasFocus" type="boolean" onChange="showrowfocus" />
         <field id="rowHasFocus" type="boolean" onChange="showrowfocus"   />





  </interface>
  <children>
        <!-- <Poster translation="[0,0]" width="384" height="372" uri="pkg:/images/temBGUF.png" /> -->

    <Poster id="itemBG" translation="[0,0]" width="424" height="239"  />
  
      
        <MaskGroup id="pmask"
        translation="[ 21, 10 ]"  maskSize = "[386, 217]"
        maskUri="pkg:/images/itM.png"  visible="true" > 
          <Poster  id="itemImage" translation="[0,0]" width="386" height="217"   />

        </MaskGroup>

        <Label
	        id="itemName"
			translation="[0,275]"
            wrap="true" maxlines="2" 
            color="#FFFFFF"
            lineSpacing= "0" 
            width="467"
            height="80"
            vertAlign="center"
            horizAlign="center"
            >

            <Font role="font" uri="pkg:/components/Fonts/Roboto-Regular.ttf" size="28" />
            
        </Label>



  </children>
    
</component>